@model IEnumerable<UniSystem.Models.Secretary>

@{
    ViewData["Title"] = "Διαχείριση Προσωπικού";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-primary fw-bold">📂 Διαχείριση Προσωπικού</h1>
        <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
            ➕ Νέο Μέλος
        </a>
    </div>

    <div class="card shadow border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="bg-primary text-white">
                    <tr>
                        <th class="py-3 ps-4">Τηλέφωνο</th>
                        <th class="py-3">Όνομα</th>
                        <th class="py-3">Επώνυμο</th>
                        <th class="py-3">Τμήμα</th>
                        <th class="py-3">Username</th>
                        <th class="py-3 text-end pe-4">Ενέργειες</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 font-monospace fw-bold text-dark">
                                📞 @Html.DisplayFor(modelItem => item.Phonenumber)
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.Name)</td>
                            <td>@Html.DisplayFor(modelItem => item.Surname)</td>
                            <td><span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.Department)</span></td>
                            <td class="text-muted fst-italic">@Html.DisplayFor(modelItem => item.UsersUsername)</td>
                            <td class="text-end pe-4">
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.Phonenumber" class="btn btn-outline-primary btn-sm" title="Επεξεργασία">✏️</a>
                                    <a asp-action="Details" asp-route-id="@item.Phonenumber" class="btn btn-outline-info btn-sm" title="Λεπτομέρειες">ℹ️</a>
                                    <a asp-action="Delete" asp-route-id="@item.Phonenumber" class="btn btn-outline-danger btn-sm" title="Διαγραφή">🗑️</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>