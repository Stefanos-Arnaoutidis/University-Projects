@model IEnumerable<CVBuilderApp.Models.PredefinedList>
@{
    ViewData["Title"] = "Διαχείριση Λιστών";
}

<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <h2 class="fw-bold text-dark mb-0">Διαχείριση Προκαθορισμένων Επιλογών</h2>
    </div>

    <div class="row align-items-start">
        <div class="col-lg-8 mb-4">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-dark text-white py-3 px-4 rounded-top-4">
                    <h5 class="mb-0 fw-bold">Καταχωρημένες Επιλογές</h5>
                </div>
                <div class="card-body p-4 bg-light">

                    <div class="table-responsive bg-white rounded-3 shadow-sm border border-light">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light border-bottom">
                                <tr>
                                    <th class="py-3 px-4 text-secondary" style="width: 10%;">ID</th>
                                    <th class="py-3 px-4 text-secondary" style="width: 40%;">Όνομα Επιλογής</th>
                                    <th class="py-3 px-4 text-secondary" style="width: 30%;">Κατηγορία</th>
                                    <th class="py-3 px-4 text-secondary text-end" style="width: 20%;">Ενέργειες</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="px-4 py-3 fw-bold text-muted">#@item.Id</td>
                                        <td class="px-4 py-3 fw-bold text-dark">@item.Name</td>
                                        <td class="px-4 py-3">
                                            @if (item.Type == "Skill")
                                            {
                                                <span class="badge bg-primary rounded-pill px-3 py-2">Δεξιότητα</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info text-dark rounded-pill px-3 py-2">Ξένη Γλώσσα</span>
                                            }
                                        </td>
                                        <td class="px-4 py-3 text-end">

                                            <button type="button" class="btn btn-sm btn-warning fw-bold text-dark me-1" data-bs-toggle="modal" data-bs-target="#editModal-@item.Id">
                                                ✏️
                                            </button>

                                            <form asp-action="DeleteListItem" method="post" class="d-inline" onsubmit="return confirm('Είστε σίγουροι ότι θέλετε να διαγράψετε αυτή την επιλογή;');">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-danger fw-bold">
                                                    🗑️
                                                </button>
                                            </form>

                                            <div class="modal fade text-start" id="editModal-@item.Id" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog">
                                                    <div class="modal-content rounded-4 border-0 shadow-lg">
                                                        <div class="modal-header bg-warning">
                                                            <h5 class="modal-title fw-bold text-dark">Επεξεργασία Επιλογής</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <form asp-action="EditListItem" method="post">
                                                            <div class="modal-body p-4">
                                                                <input type="hidden" name="id" value="@item.Id" />

                                                                <div class="mb-3">
                                                                    <label class="form-label fw-bold text-secondary">Όνομα Επιλογής</label>
                                                                    <input name="name" class="form-control bg-light border-secondary" value="@item.Name" required />
                                                                </div>

                                                                <div class="mb-3">
                                                                    <label class="form-label fw-bold text-secondary">Κατηγορία</label>
                                                                    <select name="type" class="form-select bg-light border-secondary">
                                                                        <option value="Skill" selected="@(item.Type == "Skill" ? "selected" : null)">Δεξιότητα</option>
                                                                        <option value="Language" selected="@(item.Type == "Language" ? "selected" : null)">Ξένη Γλώσσα</option>
                                                                    </select>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer bg-light border-0">
                                                                <button type="button" class="btn btn-secondary rounded-pill fw-bold" data-bs-dismiss="modal">Ακύρωση</button>
                                                                <button type="submit" class="btn btn-warning text-dark rounded-pill fw-bold px-4">Αποθήκευση</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>

                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white py-3 px-4 rounded-top-4">
                    <h5 class="mb-0 fw-bold">Προσθήκη Νέας</h5>
                </div>
                <div class="card-body p-4">

                    <form asp-action="AddListItem" method="post">

                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">Όνομα Επιλογής</label>
                            <input name="name" class="form-control bg-light border-secondary shadow-sm" required placeholder="π.χ. Java, C#, Αγγλικά" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary">Κατηγορία</label>
                            <select name="type" class="form-select bg-light border-secondary shadow-sm" required>
                                <option value="Skill">Δεξιότητα</option>
                                <option value="Language">Ξένη Γλώσσα</option>
                            </select>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary fw-bold shadow-sm rounded-pill btn-lg">
                                Αποθήκευση
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>