@model IEnumerable<CVBuilderApp.Models.Template>
@{
    ViewData["Title"] = "Διαχείριση Προτύπων";
}

<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <h2 class="fw-bold text-dark mb-0">Διαχείριση Προτύπων Βιογραφικών</h2>
    </div>

    <div class="row align-items-start">
        <div class="col-lg-8 mb-4">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-dark text-white py-3 px-4 rounded-top-4">
                    <h5 class="mb-0 fw-bold">Διαθέσιμα Πρότυπα</h5>
                </div>
                <div class="card-body p-4 bg-light">

                    <div class="table-responsive bg-white rounded-3 shadow-sm border border-light">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light border-bottom">
                                <tr>
                                    <th class="py-3 px-4 text-secondary" style="width: 10%;">ID</th>
                                    <th class="py-3 px-4 text-secondary" style="width: 30%;">Όνομα Προτύπου</th>
                                    <th class="py-3 px-4 text-secondary" style="width: 40%;">Περιγραφή</th>
                                    <th class="py-3 px-4 text-secondary text-end" style="width: 20%;">Ενέργειες</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var temp in Model)
                                {
                                    <tr>
                                        <td class="px-4 py-3 fw-bold text-muted">#@temp.Id</td>
                                        <td class="px-4 py-3 fw-bold text-dark">@temp.Name</td>
                                        <td class="px-4 py-3 text-muted">@temp.Description</td>
                                        <td class="px-4 py-3 text-end">

                                            <button type="button" class="btn btn-sm btn-warning fw-bold text-dark me-1" data-bs-toggle="modal" data-bs-target="#editModal-@temp.Id">
                                                ✏️
                                            </button>

                                            <form asp-action="DeleteTemplate" method="post" class="d-inline" onsubmit="return confirm('Είστε σίγουροι ότι θέλετε να διαγράψετε αυτό το πρότυπο;');">
                                                <input type="hidden" name="id" value="@temp.Id" />
                                                <button type="submit" class="btn btn-sm btn-danger fw-bold">
                                                    🗑️
                                                </button>
                                            </form>

                                            <div class="modal fade text-start" id="editModal-@temp.Id" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog">
                                                    <div class="modal-content rounded-4 border-0 shadow-lg">
                                                        <div class="modal-header bg-warning">
                                                            <h5 class="modal-title fw-bold text-dark">Επεξεργασία Προτύπου</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <form asp-action="EditTemplate" method="post">
                                                            <div class="modal-body p-4">
                                                                <input type="hidden" name="id" value="@temp.Id" />
                                                                <div class="mb-3">
                                                                    <label class="form-label fw-bold text-secondary">Όνομα</label>
                                                                    <input name="name" class="form-control bg-light border-secondary" value="@temp.Name" required />
                                                                </div>
                                                                <div class="mb-3">
                                                                    <label class="form-label fw-bold text-secondary">Περιγραφή</label>
                                                                    <input name="description" class="form-control bg-light border-secondary" value="@temp.Description" required />
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer bg-light border-0">
                                                                <button type="button" class="btn btn-secondary rounded-pill fw-bold" data-bs-dismiss="modal">Ακύρωση</button>
                                                                <button type="submit" class="btn btn-warning text-dark rounded-pill fw-bold px-4">Αποθήκευση</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>

                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white py-3 px-4 rounded-top-4">
                    <h5 class="mb-0 fw-bold">Προσθήκη Νέου</h5>
                </div>
                <div class="card-body p-4">

                    <form asp-action="AddTemplate" method="post">

                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary">Όνομα</label>
                            <input name="name" class="form-control bg-light border-secondary shadow-sm" required placeholder="π.χ. Μοντέρνο" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary">Περιγραφή</label>
                            <input name="description" class="form-control bg-light border-secondary shadow-sm" required placeholder="π.χ. Με δημιουργικό σχεδιασμό" />
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary fw-bold shadow-sm rounded-pill btn-lg">
                                Αποθήκευση
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>