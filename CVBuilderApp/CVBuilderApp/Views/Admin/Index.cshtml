@model IEnumerable<CVBuilderApp.Models.User>
@{
    ViewData["Title"] = "Έγκριση Συμβούλων";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">

        <div class="card-header bg-dark text-white py-4 px-4 rounded-top-4">
            <h3 class="mb-1 fw-bold">Εκκρεμείς Εγκρίσεις Συμβούλων</h3>
            <p class="mb-0 text-light opacity-75">Διαχειριστείτε τα αιτήματα εγγραφής νέων συμβούλων καριέρας.</p>
        </div>

        <div class="card-body p-4 bg-light">

            @if (!Model.Any())
            {
                <div class="alert alert-success d-flex align-items-center shadow-sm border-0 rounded-3 p-4" role="alert">
                    <div class="fs-1 me-4">✅</div>
                    <div>
                        <h5 class="alert-heading fw-bold mb-1">Όλα έτοιμα!</h5>
                        <p class="mb-0 text-muted">Δεν υπάρχουν σύμβουλοι σε αναμονή. Όλοι έχουν εγκριθεί!</p>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive bg-white rounded-3 shadow-sm border border-light">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th class="py-3 px-4 text-secondary text-uppercase" style="font-size: 0.85rem;">Ονοματεπώνυμο</th>
                                <th class="py-3 px-4 text-secondary text-uppercase" style="font-size: 0.85rem;">Email</th>
                                <th class="py-3 px-4 text-end text-secondary text-uppercase" style="font-size: 0.85rem;">Ενέργεια</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td class="px-4 py-3 fw-bold text-dark fs-5">
                                        @user.FirstName @user.LastName
                                    </td>
                                    <td class="px-4 py-3 text-muted">
                                        @user.Email
                                    </td>
                                    <td class="px-4 py-3 text-end">
                                        <form asp-action="ApproveCounselor" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="btn btn-success btn-sm px-4 shadow-sm fw-bold rounded-pill">
                                                Ενεργοποίηση ✔️
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>