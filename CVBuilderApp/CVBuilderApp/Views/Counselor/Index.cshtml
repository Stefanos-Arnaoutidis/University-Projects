@model IEnumerable<CVBuilderApp.Models.Resume>
@{
    ViewData["Title"] = "Πάνελ Συμβούλου";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">

        <div class="card-header bg-dark text-white py-4 px-4 rounded-top-4">
            <h3 class="mb-1 fw-bold">Διαχείριση & Αξιολόγηση Βιογραφικών</h3>
            <p class="mb-0 text-light opacity-75">Ακολουθεί η λίστα με τα βιογραφικά των χρηστών που εκκρεμούν προς έλεγχο.</p>
        </div>

        <div class="card-body p-4 bg-light">

            @if (!Model.Any())
            {
                <div class="alert alert-success d-flex align-items-center shadow-sm border-0 rounded-3 p-4" role="alert">
                    <div class="fs-1 me-4">🎉</div>
                    <div>
                        <h5 class="alert-heading fw-bold mb-1">Όλα καθαρά!</h5>
                        <p class="mb-0 text-muted">Δεν υπάρχουν βιογραφικά που εκκρεμούν προς έλεγχο αυτή τη στιγμή. Έχετε ολοκληρώσει όλες τις αξιολογήσεις.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive bg-white rounded-3 shadow-sm border border-light">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th class="py-3 px-4 text-secondary text-uppercase" style="font-size: 0.85rem;">Κωδικός CV</th>
                                <th class="py-3 px-4 text-secondary text-uppercase" style="font-size: 0.85rem;">Κατάσταση</th>
                                <th class="py-3 px-4 text-end text-secondary text-uppercase" style="font-size: 0.85rem;">Ενέργεια</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cv in Model)
                            {
                                <tr>
                                    <td class="px-4 py-3 fw-bold text-dark fs-5">
                                        #@cv.Id
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm fw-bold">
                                            ⏳ @cv.Status
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 text-end">
                                        <a asp-controller="Counselor" asp-action="Evaluate" asp-route-id="@cv.Id" class="btn btn-primary btn-sm px-4 shadow-sm fw-bold rounded-pill">
                                            Αξιολόγηση &rarr;
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>